# Kết nối Postgres (docker-compose.yml map ra cổng 5437)
DATABASE_URL="postgresql://eduquiz:eduquiz_dev_password@localhost:5437/eduquiz?schema=public"

# Auth.js — tạo chuỗi ngẫu nhiên: npx auth secret
AUTH_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai"

# Mật khẩu cho tài khoản mẫu khi seed
SEED_DEFAULT_PASSWORD="EduQuiz@2026"

# Thư mục lưu file tải lên (mặc định ./storage)
STORAGE_DIR="storage"

# ─── CHỈ PRODUCTION (docker-compose.prod.yml) ───────────────────────
# DATABASE_URL + STORAGE_DIR được compose tự đặt, không cần sửa 2 dòng trên.
# Mật khẩu Postgres — chỉ dùng chữ + số (nằm trong URL): openssl rand -hex 24
# POSTGRES_PASSWORD="..."
# AUTH_SECRET ở trên PHẢI đổi — tạo: openssl rand -base64 32
# SEED_DEFAULT_PASSWORD ở trên nên đổi — mật khẩu các tài khoản mẫu trên web demo.
