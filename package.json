{
  "name": "edu-quiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:studio": "prisma studio",
    "verify": "tsx scripts/verify-grading.ts && tsx scripts/verify-homework.ts && tsx scripts/verify-question-bank.ts && tsx scripts/verify-exam-import.ts && tsx scripts/verify-classes.ts && tsx scripts/verify-teachers.ts && tsx scripts/verify-content.ts && tsx scripts/verify-banks.ts && tsx scripts/verify-publish.ts && tsx scripts/verify-print.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.10.1",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@xmldom/xmldom": "^0.8.15",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.15.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.10.1": true
  }
}
